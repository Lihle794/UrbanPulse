{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbanpulse.local/schemas/traffic_observation.schema.json",
  "title": "UrbanPulse Traffic Observation",
  "description": "Schema for synthetic Johannesburg road-segment traffic observations generated by UrbanPulse.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_timestamp",
    "source",
    "segment_id",
    "road_name",
    "latitude",
    "longitude",
    "average_speed_kmh",
    "vehicle_count",
    "congestion_level",
    "travel_time_seconds"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "traffic_observation"
    },
    "event_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "const": "urbanpulse_traffic_simulator"
    },
    "segment_id": {
      "type": "string",
      "pattern": "^JHB-SEG-[0-9]{3}$"
    },
    "road_name": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -26.5,
      "maximum": -25.8
    },
    "longitude": {
      "type": "number",
      "minimum": 27.7,
      "maximum": 28.4
    },
    "average_speed_kmh": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "vehicle_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "congestion_level": {
      "type": "string",
      "enum": [
        "free_flow",
        "moderate",
        "heavy",
        "severe"
      ]
    },
    "travel_time_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    }
  }
}