{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UrbanPulse Incident Event",
  "description": "Schema for synthetic Johannesburg road incident events generated by UrbanPulse.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_timestamp",
    "source",
    "incident_id",
    "incident_type",
    "severity",
    "status",
    "segment_id",
    "road_name",
    "latitude",
    "longitude",
    "description",
    "reported_at",
    "estimated_clearance_minutes"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "incident"
    },
    "event_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "const": "urbanpulse_incident_simulator"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^JHB-INC-[0-9]{6}$"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "collision",
        "road_closure",
        "vehicle_breakdown",
        "construction",
        "road_hazard"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "monitoring",
        "cleared"
      ]
    },
    "segment_id": {
      "type": "string",
      "pattern": "^JHB-SEG-[0-9]{3}$"
    },
    "road_name": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -26.5,
      "maximum": -25.8
    },
    "longitude": {
      "type": "number",
      "minimum": 27.7,
      "maximum": 28.4
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_clearance_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    }
  }
}