{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UrbanPulse Vehicle Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_timestamp",
    "source",
    "vehicle_id",
    "route_id",
    "latitude",
    "longitude",
    "speed_kmh",
    "heading",
    "occupancy_status",
    "vehicle_status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "vehicle_telemetry"
    },
    "event_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "const": "urbanpulse_vehicle_simulator"
    },
    "vehicle_id": {
      "type": "string",
      "pattern": "^JHB-BUS-[0-9]{3}$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^ROUTE-[0-9]{2}$"
    },
    "latitude": {
      "type": "number",
      "minimum": -26.5,
      "maximum": -25.8
    },
    "longitude": {
      "type": "number",
      "minimum": 27.7,
      "maximum": 28.4
    },
    "speed_kmh": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "heading": {
      "type": "integer",
      "minimum": 0,
      "maximum": 359
    },
    "occupancy_status": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "vehicle_status": {
      "type": "string",
      "enum": [
        "in_service",
        "delayed",
        "out_of_service"
      ]
    }
  }
}